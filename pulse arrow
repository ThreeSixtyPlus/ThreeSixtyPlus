<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  html, body {
    margin: 0;
    padding: 0;
    background: transparent;
    overflow: hidden;
  }
  .hint {
    position: relative;
    width: 90px;
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* click ripple rings */
  .ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    border: 2px solid #D4AF37;
    border-radius: 50%;
    transform: scale(0.4);
    opacity: 0;
    animation: ripple 2s ease-out infinite;
  }
  .ring:nth-child(2) { animation-delay: 0.6s; }
  @keyframes ripple {
    0%   { transform: scale(0.4); opacity: 0.85; }
    100% { transform: scale(2.4); opacity: 0; }
  }
  /* cursor */
  .cursor {
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.3));
    animation: tap 2s ease-in-out infinite;
  }
  @keyframes tap {
    0%, 100% { transform: translate(0, 0); }
    45%      { transform: translate(-5px, -5px); }
    55%      { transform: translate(0, 0); }
  }
</style>
</head>
<body>
  <div class="hint">
    <span class="ring"></span>
    <span class="ring"></span>
    <svg class="cursor" width="30" height="30" viewBox="0 0 24 24">
      <path d="M4 2 L4 18 L8.5 13.5 L11.5 20 L14 18.8 L11 12.5 L17 12.5 Z"
            fill="#C9920A" stroke="#ffffff" stroke-width="1.3" stroke-linejoin="round"/>
    </svg>
  </div>
</body>
</html>
